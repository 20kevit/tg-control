# Copy to .env only if you understand the consequences. This file contains
# placeholders and never real credentials.
#
# Secrets are NOT configured here. They are mounted as files from ./secrets
# (see docs/DEPLOYMENT.md and scripts/init_synthetic_secrets.py):
#   secrets/postgres_password, secrets/database_url,
#   secrets/owner_token, secrets/encryption_key,
#   secrets/backup_database_url, secrets/backup_key
#
# Required (no safe default, container refuses to start without them):
#   secrets/database_url      PostgreSQL DSN with +psycopg driver
#   secrets/owner_token       >= 32 characters, owner plane only
#   secrets/encryption_key    URL-safe base64 Fernet key
#
# Optional runtime configuration (safe synthetic defaults shown):
TG_UID=10001
TG_GID=10001
TG_ALLOWED_HOSTS=localhost,127.0.0.1
TG_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TG_LOG_LEVEL=INFO
# Leave TG_SYNTHETIC_STATE_DIR unset to keep simulator state ephemeral.
